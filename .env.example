# ╔══════════════════════════════════════════════════════════════╗
# ║  AI Kosh – Environment Variables  (copy to .env)            ║
# ╚══════════════════════════════════════════════════════════════╝
#
# Only ONE LLM backend needs to be configured.
# The app picks the best available automatically:
#   Azure OpenAI (all 3 keys set) → NVIDIA NIM → Groq (default)


# ── PERSONAL LAPTOP — Groq / NVIDIA ─────────────────────────

GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional — leave blank to fall back to Groq
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct


# ── OFFICE LAPTOP — Azure OpenAI ─────────────────────────────
# Set all three (KEY + ENDPOINT + DEPLOYMENT_NAME) to enable Azure.
# Leave ALL blank on personal laptop — falls back to Groq/NVIDIA.

AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_MODEL_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT_NAME=text-embedding-3-small
AZURE_OPENAI_EMBEDDINGS_MODEL_NAME=text-embedding-3-small


# ── OFFICE LAPTOP — Azure Storage ────────────────────────────

AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_BLOB_CONTAINER_NAME=


# ── OFFICE LAPTOP — Azure Document Intelligence ───────────────

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=


# ── BOTH LAPTOPS — Shared services ───────────────────────────

# Hugging Face token (local models: BLIP, CLIP, Pyannote)
HF_TOKEN=hf_your-token-here

# data.gov.in Open Data Catalog
DATA_GOV_API_KEY=

# FFmpeg (needed for audio/video analysis)
# macOS (homebrew): brew install ffmpeg
# Linux:            sudo apt install ffmpeg
# Windows:          winget install Gyan.FFmpeg
FFMPEG_PATH=
FFPROBE_PATH=


# ── PORTS ────────────────────────────────────────────────────
# On shared remote desktops, change these to values unique to YOU
# so your instance doesn't clash with teammates on the same machine.
# Default values (8742 / 3652) are already non-standard.
#
# Rule: VITE_API_URL must always match BACKEND_PORT.

BACKEND_PORT=8742
VITE_PORT=3652
VITE_API_URL=http://localhost:8742


# ── Azure Computer Vision (optional image captioning) ────────
# Leave blank — local BLIP model is used when not set.
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=
