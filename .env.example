# ╔══════════════════════════════════════════════════════════════╗
# ║  AI Kosh – Backend Environment Variables (copy to .env)     ║
# ╚══════════════════════════════════════════════════════════════╝

# --- Groq LLM (required for text/NLP analysis) ---
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- HuggingFace (required for Pyannote speaker diarization) ---
HF_TOKEN=hf_your-token-here

# --- Audio: ffmpeg (required for MP3/M4A → WAV conversion) ---
#
# Option A (recommended): Install ffmpeg globally so it's in PATH.
#   Windows:  winget install Gyan.FFmpeg
#             -- or -- choco install ffmpeg
#   macOS:    brew install ffmpeg
#   Linux:    sudo apt install ffmpeg
#   Then leave FFMPEG_PATH and FFPROBE_PATH empty below.
#
# Option B: Set the full path to the ffmpeg/ffprobe executables:
#   FFMPEG_PATH=C:\path\to\ffmpeg.exe
#   FFPROBE_PATH=C:\path\to\ffprobe.exe
#
# If ffmpeg is in PATH, leave these empty (the code will find it automatically):
FFMPEG_PATH=
FFPROBE_PATH=

# --- NVIDIA (optional, for GPU-accelerated image models) ---
NVIDIA_API_KEY=

# --- Azure Vision (optional, for image captioning fallback) ---
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=

# --- Local ports / CORS (Remote Desktop specific) ---
BACKEND_PORT=9080
FRONTEND_PORT=5179
# Optional override (comma-separated). Leave empty to auto-use FRONTEND_PORT.
# FRONTEND_ORIGINS=http://localhost:5179,http://127.0.0.1:5179

# --- YAMNet Background Noise Detection ---
YAMNET_ENABLED=true
YAMNET_MODEL_URL=https://tfhub.dev/google/yamnet/1
YAMNET_CONFIDENCE_THRESHOLD=0.2
YAMNET_MAX_PENALTY_POINTS=25
YAMNET_CHUNK_SECONDS=30
YAMNET_FRAME_HOP_SECONDS=0.48
YAMNET_NOISE_CONFIG_PATH=
# Optional JSON object to override category penalty weights, e.g. {"ac_fan":0.6,"tv_media":0.8}
YAMNET_PENALTY_WEIGHTS_JSON=
